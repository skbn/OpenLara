%{noixemul:%(startfile_libnix)} %{mcrt=nix*:%(startfile_libnix)} %{mcrt=ixemul:%(startfile_ixemul)} %{mcrt=clib2:%(startfile_clib2)} %{!mcrt=*:%{!noixemul:%(startfile_newlib)}} 

